<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- تم اصلی اپ -->
    <style name="Theme.Meelano" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- تم اسپلش (نمایش لوگو هنگام اجرا) -->
    <style name="Theme.Splash.Meelano" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
